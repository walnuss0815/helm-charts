{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "customManagers:helmChartYamlAppVersions",
    "local>walnuss0815/helm-charts//charts/immich/renovate-custom-managers",
    "local>walnuss0815/helm-charts//charts/keycloak/renovate-custom-managers"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "rebaseWhen": "behind-base-branch",
  "helm-values": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Minor updates of stateful apps can run database migrations: merge them manually",
      "matchFileNames": [
        "charts/immich/**",
        "charts/keycloak/**",
        "charts/odoo/**",
        "charts/paperless-ngx/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    }
  ]
}

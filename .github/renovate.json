{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "customManagers:helmChartYamlAppVersions",
    "local>walnuss0815/helm-charts//charts/immich/renovate-custom-managers"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "rebaseWhen": "behind-base-branch",
  "helm-values": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
